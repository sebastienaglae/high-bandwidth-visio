{
  "name": "visio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:desktop": "npm run dev -w desktop",
    "build:desktop": "npm run build -w desktop",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test -w shared && npm run test -w server && npm run test -w web"
  },
  "devDependencies": {
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
