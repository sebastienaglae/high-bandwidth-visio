# Public IPv4 of your VPS (what WebRTC clients must reach).
# Required in production when LISTEN_IP=0.0.0.0.
ANNOUNCED_IP=203.0.113.10

# Domain pointing at the VPS for automatic HTTPS (Let's Encrypt).
# Leave as ":80" only for local testing - browsers require HTTPS
# (or localhost) for camera/microphone access.
SITE_ADDRESS=visio.example.com

# Set to 1 when the server runs behind the reverse proxy (docker compose
# does this automatically via the container network; only needed for
# custom proxy setups so rate limiting sees real client IPs).
TRUST_PROXY=0

# Capacity tuning (optional)
MAX_ROOMS=200
MAX_PEERS_PER_ROOM=24
SPEEDTEST_COOLDOWN_MS=30000

# TURN relay (strongly recommended for any public deployment; required for
# participants behind restrictive or symmetric NATs). Enable the coturn
# profile and use the same username/credential below, or use external TURN:
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# TURN_URLS=turn:<vps-ip>:3478?transport=udp
# TURN_USERNAME=visio
# TURN_CREDENTIAL=<generate-with-openssl-rand-hex-32>

# Required when enabling the observability profile. Grafana is bound to
# localhost by default; reach it through an SSH tunnel.
# GRAFANA_PASSWORD=<generate-with-openssl-rand-base64-32>
